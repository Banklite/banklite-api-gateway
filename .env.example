# Copia este archivo a .env. No subas el .env real.
# JWT_SECRET debe ser IGUAL al de identity-service.
JWT_SECRET=cambiar-esto
AUTH_ENFORCE=true
ADMIN_PREFIXES=compliance/,analytics/
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_SENSITIVE_PER_MINUTE=15
UPSTREAM_TIMEOUT_SECONDS=90
IDENTITY_SERVICE_URL=http://identity-service:8001
ACCOUNT_SERVICE_URL=http://account-service:8002
LEDGER_SERVICE_URL=http://ledger-service:8003
TRANSFER_SERVICE_URL=http://transfer-service:8004
CARD_SERVICE_URL=http://card-service:8005
FRAUD_SERVICE_URL=http://fraud-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
COMPLIANCE_SERVICE_URL=http://compliance-service:8008
